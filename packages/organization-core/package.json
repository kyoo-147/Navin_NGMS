{
  "name": "@navin/organization-core",
  "version": "0.1.0",
  "private": true,
  "description": "Organization/admin actions (reversible alias provisioning) composed over the action ledger and the mail-engine adapter boundary",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@navin/action-core": "workspace:*",
    "@navin/contracts": "workspace:*",
    "@navin/engine-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
