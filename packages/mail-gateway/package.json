{
  "name": "@navin/mail-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Normalized server-side JMAP gateway (BFF) for Navin Mail with credential isolation",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@navin/contracts": "workspace:*",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/sanitize-html": "2.16.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
