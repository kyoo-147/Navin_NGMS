{
  "name": "@navin/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed REST + SSE client for the Navin Mail and Control surfaces",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier --write src tests package.json",
    "lint": "eslint src tests",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@navin/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
