{
  "name": "@navin/migration-core",
  "version": "0.1.0",
  "private": true,
  "description": "Checkpointed, protocol-neutral mailbox migration with truthful recovery semantics.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "vitest": "3.2.7"
  }
}
