# Navin W03 — isolated acceptance environment configuration.
#
# Non-secret and safe to commit. This file is BOTH:
#   * sourced by the acceptance shell scripts (KEY=value), and
#   * passed to `docker compose --env-file` for interpolation.
#
# NEVER add production hosts, IPs, domains, ports or credentials here.
# The production guard (guard.sh) fails closed if any production identifier
# appears anywhere in the acceptance environment.

# --- Isolated compose project and resource names ------------------------------
COMPOSE_PROJECT_NAME=navin-acceptance
NAVIN_ACCEPTANCE_NETWORK=navin-acceptance
NAVIN_ACCEPTANCE_VOLUME_ETC=navin-acceptance-stalwart-etc
NAVIN_ACCEPTANCE_VOLUME_LIB=navin-acceptance-stalwart-lib

# --- Fixture identity (RFC 6761 reserved, non-routable .test domain) ----------
NAVIN_ACCEPTANCE_DOMAIN=company.test
NAVIN_ACCEPTANCE_MAIL_HOSTNAME=mail.company.test
NAVIN_ACCEPTANCE_ALICE=alice
NAVIN_ACCEPTANCE_BOB=bob
NAVIN_ACCEPTANCE_ALIAS=team

# --- Loopback-only, non-production host ports ---------------------------------
NAVIN_ACCEPTANCE_SMTP_PORT=10025
NAVIN_ACCEPTANCE_SUBMISSION_PORT=10587
NAVIN_ACCEPTANCE_IMAP_PORT=10143
NAVIN_ACCEPTANCE_IMAPS_PORT=10993
NAVIN_ACCEPTANCE_HTTP_PORT=18080

# --- Pinned images (version + digest). Digests resolved 2026-10-01 ------------
NAVIN_ACCEPTANCE_STALWART_IMAGE=stalwartlabs/stalwart:v0.16.24@sha256:ec011be228596e37e65f41aab17deed573859614430472f7eeb42178c50d87b7
NAVIN_ACCEPTANCE_STALWART_DIGEST=sha256:ec011be228596e37e65f41aab17deed573859614430472f7eeb42178c50d87b7
NAVIN_ACCEPTANCE_CLI_IMAGE=ghcr.io/stalwartlabs/cli:1.0.13@sha256:9a1e07307d6f890a193322c4b737fc0868405f0f8486a19922cbf362f43884fd
NAVIN_ACCEPTANCE_CLI_DIGEST=sha256:9a1e07307d6f890a193322c4b737fc0868405f0f8486a19922cbf362f43884fd

# --- Readiness timeout (seconds) ----------------------------------------------
NAVIN_ACCEPTANCE_READY_TIMEOUT=240
