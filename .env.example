# Public identity
DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
WEBMAIL_HOSTNAME=webmail.example.com
ADMIN_EMAIL=admin@example.com
TIMEZONE=Asia/Ho_Chi_Minh

# Server addresses
SERVER_IPV4=203.0.113.10
# Leave blank until IPv6 forward and reverse DNS are both correct.
SERVER_IPV6=
# Space-separated selectors emitted by Stalwart after bootstrap.
DKIM_SELECTORS=

# Pinned production images
STALWART_IMAGE=stalwartlabs/stalwart:v0.16.24
SNAPPYMAIL_IMAGE=djmaze/snappymail:v2.38.2
STALWART_CLI_IMAGE=ghcr.io/stalwartlabs/cli:1.0.13

# Local-only HTTP bindings consumed by the existing host Nginx.
STALWART_HTTP_BIND=127.0.0.1:8082
SNAPPYMAIL_HTTP_BIND=127.0.0.1:8888

# Backup retention on this host. Offsite copy is still required.
BACKUP_RETENTION_DAYS=7
